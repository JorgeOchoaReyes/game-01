# --- Firebase (Auth + Firestore) ----------------------------------------------
# Leave all of these empty locally: the app then uses the Firebase Emulators
# (`pnpm --filter @polly/web emulators`). Required in production.
# Web app config (Firebase console > Project settings > Your apps). Public.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Admin SDK service account (Project settings > Service accounts). Server only.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The private_key from the JSON, newlines as \n.
FIREBASE_PRIVATE_KEY=

# --- Polly ---------------------------------------------------------------------
# Public origin used in links (playUrl, downloadUrl, the OpenAPI servers URL).
# Defaults to the request's own origin.
POLLY_PUBLIC_URL=

# --- Frankie (the embedded AI chat) -------------------------------------------
# Shared with your Frankie workspace: Polly signs user tokens with it, Frankie
# verifies them and forwards them back to /api/v1 as the user.
FRANKIE_JWT_SECRET=
# Your Frankie workspace's publishable key (safe for the browser).
NEXT_PUBLIC_FRANKIE_PUBLISHABLE_KEY=
# Only if you self-host Frankie; defaults to Frankie Cloud.
NEXT_PUBLIC_FRANKIE_URL=

# --- Multiplayer --------------------------------------------------------------
# Where Kit.net connects (apps/relay).
NEXT_PUBLIC_RELAY_URL=ws://localhost:8787

# Stripe: Polly Studio Pro, $10/month (scripts/stripe-setup.mjs prints the price id).
# Leave unset to switch billing off: nobody is capped.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

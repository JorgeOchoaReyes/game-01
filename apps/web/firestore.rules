rules_version = '2';

// Polly's server reads and writes Firestore with the Admin SDK, which skips
// these rules. Browsers never touch Firestore directly: every change goes
// through the API, which checks ownership, versions and the game's code.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
